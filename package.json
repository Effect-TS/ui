{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel --filter \"./packages/**/*\" run codegen",
    "codemod": "node scripts/codemod.mjs",
    "bundle-size": "node packages/ui/benchmark/bundle-size/run.mjs",
    "build": "tsc -b tsconfig.packages.json && pnpm --recursive --parallel --filter \"./packages/*\" run build && node scripts/copy-ai-docs.mjs",
    "circular": "node scripts/circular.mjs",
    "test": "vitest",
    "doctest": "vitest --config vitest.docs.ts",
    "coverage": "vitest --coverage",
    "check": "effect-tsgo tsrs -b tsconfig.json",
    "check-tsc": "tsc -b tsconfig.json",
    "check-recursive": "pnpm --recursive --filter \"./packages/**/*\" exec tsc -b tsconfig.json",
    "check-dist-types": "node scripts/check-dist-types.mjs",
    "jsdocs": "effect-jsdocs",
    "lint": "oxlint -f unix && dprint check",
    "lint-fix": "oxlint --fix && dprint fmt",
    "ai-docgen": "effect-ai-docgen ai-docs/src -o LLMS.md",
    "ai-docgen:watch": "pnpm ai-docgen --watch",
    "test-types": "tstyche --target '>=5.9'",
    "changeset-version": "changeset version",
    "changeset-publish": "node scripts/set-strip-internal.mjs && pnpm codemod && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@babel/plugin-transform-export-namespace-from": "^8.1.3",
    "@babel/plugin-transform-modules-commonjs": "^8.1.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/ai-docgen": "workspace:^",
    "@effect/doctest": "^4.1.5",
    "@effect/jsdocs": "workspace:^",
    "@effect/oxc": "workspace:^",
    "@effect/tsgo": "^0.73.4",
    "@effect/utils": "workspace:^",
    "@effect/vitest": "^4.1.6",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.1",
    "ast-types": "^0.16.3",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "dprint": "^0.65.0",
    "effect": "^4.1.6",
    "fast-check": "^4.11.0",
    "glob": "^14.0.4",
    "happy-dom": "^21.0.4",
    "jscodeshift": "^17.4.0",
    "madge": "^8.0.0",
    "oxlint": "^1.95.0",
    "pkg-pr-new": "0.0.94",
    "playwright": "^1.65.0",
    "tstyche": "^7.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": ["./packages/tools/oxc/oxlintrc.json"],
  "ignorePatterns": [
    "LLMS.md",
    "**/dist",
    "**/build",
    "**/docs",
    "**/*.tsbuildinfo",
    "**/CHANGELOG.md",
    "!scratchpad/**/*",
    "**/.*",
    "!.changeset",
    "!.changeset/**/*",
    "!.envrc",
    "!.github",
    "!.github/**/*",
    "!.gitignore",
    "!.oxlintrc.json",
    "!.vscode",
    "!.vscode/**/*"
  ],
  "jsPlugins": ["@effect/oxc/oxlint"],
  "overrides": [{
    "files": [
      "**/{test,typetest,examples,ai-docs,benchmark,bundle,scripts,scratchpad}/**"
    ],
    "rules": {
      "effect/no-bigint-literals": "off",
      "eslint/no-console": "off",
      "effect/no-import-from-barrel-package": "off"
    }
  }, {
    // Only @effect/ui/html may use DOM types, so nothing else in @effect/ui imports it.
    "files": ["packages/ui/src/**"],
    "rules": {
      "eslint/no-restricted-imports": ["error", {
        "patterns": [{
          "regex": "(^|/)ui/html(/|$)|^\\.{1,2}/(\\.\\./)*html(/|$)",
          "message": "Only @effect/ui/html may use DOM types; nothing else in @effect/ui may import it."
        }]
      }]
    }
  }, {
    "files": ["packages/ui/src/html/**"],
    "rules": {
      "eslint/no-restricted-imports": "off"
    }
  }, {
    // DOM instanceof checks fail across windows; use internal/dom.ts guards for nodes.
    "files": ["packages/ui-kit/src/**"],
    "rules": {
      "unicorn/no-instanceof-builtins": ["error", {
        "include": [
          "Node",
          "Element",
          "HTMLElement",
          "HTMLInputElement",
          "HTMLTextAreaElement",
          "SVGElement",
          "Document",
          "ShadowRoot",
          "Text",
          "Event",
          "MouseEvent",
          "PointerEvent",
          "KeyboardEvent",
          "FocusEvent"
        ]
      }]
    }
  }, {
    // Optional readers use shared keys from internal/ so standalone bundles omit unused owners.
    "files": [
      "packages/ui-kit/src/Menu.ts",
      "packages/ui-kit/src/Select.ts",
      "packages/ui-kit/src/ToggleGroup.ts",
      "packages/ui-kit/src/Checkbox.ts"
    ],
    "rules": {
      "eslint/no-restricted-imports": ["error", {
        "patterns": [{
          "regex": "(^|/)(Menubar|Toolbar|CheckboxGroup)(\\.ts)?$",
          "allowTypeImports": true,
          "message": "Read optional owners through their shared key in internal/ so standalone bundles omit unused owner implementations."
        }]
      }]
    }
  }]
}

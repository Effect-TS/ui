{
  "name": "@effect/ui",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "A Layer-composed frontend framework for Effect",
  "homepage": "https://effect.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Effect-TS/ui/issues"
  },
  "tags": [
    "typescript",
    "ui",
    "frontend",
    "framework",
    "effect"
  ],
  "keywords": [
    "typescript",
    "ui",
    "frontend",
    "framework",
    "effect"
  ],
  "sideEffects": [],
  "imports": {
    "#dev": {
      "production": "./src/internal/devOff.ts",
      "default": "./src/internal/devOn.ts"
    },
    "#hot": {
      "production": "./src/html/internal/hotOff.ts",
      "default": "./src/html/internal/hotOn.ts"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./html": "./src/html/index.ts",
    "./html/testing": "./src/html/testing/index.ts",
    "./html/MarkdownContent": {
      "types": "./src/html/MarkdownContent.d.ts"
    },
    "./html/HtmlServerViteDocument": {
      "types": "./src/html/HtmlServerViteDocument.d.ts"
    },
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./html/internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "imports": {
      "#dev": {
        "production": "./dist/internal/devOff.js",
        "default": "./dist/internal/devOn.js"
      },
      "#hot": {
        "production": "./dist/html/internal/hotOff.js",
        "default": "./dist/html/internal/hotOn.js"
      }
    },
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./testing": "./dist/testing/index.js",
      "./html": "./dist/html/index.js",
      "./html/testing": "./dist/html/testing/index.js",
      "./html/MarkdownContent": {
        "types": "./src/html/MarkdownContent.d.ts"
      },
      "./html/HtmlServerViteDocument": {
        "types": "./src/html/HtmlServerViteDocument.d.ts"
      },
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./html/internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "codegen": "effect-utils codegen",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json",
    "check-pause": "node test/browser/check-pause.mjs",
    "check-ssr": "node test/browser/check-ssr.mjs"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.1.5",
    "@types/node": "^26.6.10",
    "commonmark-spec": "^0.31.2",
    "effect": "^4.1.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}

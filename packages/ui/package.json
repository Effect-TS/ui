{
  "name": "@effect/ui",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "A Layer-composed frontend framework for Effect",
  "homepage": "https://effect.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Effect-TS/ui/issues"
  },
  "tags": [
    "typescript",
    "ui",
    "frontend",
    "framework",
    "effect"
  ],
  "keywords": [
    "typescript",
    "ui",
    "frontend",
    "framework",
    "effect"
  ],
  "sideEffects": [
    "./src/html/register.ts",
    "./dist/html/register.js"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts",
    "./html": "./src/html/index.ts",
    "./html/testing": "./src/html/testing/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./html/internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./testing": "./dist/testing/index.js",
      "./html": "./dist/html/index.js",
      "./html/testing": "./dist/html/testing/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./html/internal/*": null,
      "./index": null,
      "./*/index": null
    }
  },
  "scripts": {
    "codegen": "effect-utils codegen",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.1.4",
    "@types/node": "^26.6.6",
    "effect": "^4.1.4",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}

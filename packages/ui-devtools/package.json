{
  "name": "@effect/ui-devtools",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "An inspector, overlay and MCP server for @effect/ui's message log",
  "homepage": "https://effect.website",
  "repository": {
    "type": "git",
    "url": "https://github.com/Effect-TS/ui.git",
    "directory": "packages/ui-devtools"
  },
  "bugs": {
    "url": "https://github.com/Effect-TS/ui/issues"
  },
  "tags": [
    "typescript",
    "ui",
    "devtools",
    "effect"
  ],
  "keywords": [
    "typescript",
    "ui",
    "devtools",
    "effect"
  ],
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./node": "./src/node/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "bin": {
    "effect-ui-devtools": "./src/node/internal/bin.ts"
  },
  "files": [
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "AGENTS.md",
    "CLAUDE.md",
    "ai-docs/**/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./node": "./dist/node/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "bin": {
      "effect-ui-devtools": "./dist/node/internal/bin.js"
    }
  },
  "scripts": {
    "codegen": "effect-utils codegen",
    "check-hit-testing": "node test/browser/check-hit-testing.mjs",
    "check-panel": "node test/browser/check-panel.mjs",
    "check-parity": "node test/browser/check-parity.mjs",
    "check-pause": "node test/browser/check-pause.mjs",
    "check-scale": "node test/browser/check-scale.mjs",
    "build": "tsc -b tsconfig.json && pnpm babel",
    "babel": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "check": "tsc -b tsconfig.json"
  },
  "peerDependencies": {
    "@effect/platform-node": "^4.1.4",
    "@effect/ui": "workspace:^",
    "@effect/ui-kit": "workspace:^",
    "effect": "^4.1.4"
  },
  "devDependencies": {
    "@effect/platform-node": "^4.1.4",
    "@effect/ui": "workspace:^",
    "@effect/ui-kit": "workspace:^",
    "effect": "^4.1.4",
    "@types/node": "^26.6.6"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  }
}

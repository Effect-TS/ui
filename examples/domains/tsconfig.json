{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "vite.config.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false
  }
}

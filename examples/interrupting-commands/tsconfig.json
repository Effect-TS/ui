{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "vite.config.ts"],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "types": ["vite/client"],
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "incremental": false
  }
}
